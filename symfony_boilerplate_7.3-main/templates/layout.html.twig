{% extends 'base.html.twig' %}

{% block body %}
<div class="flex min-h-screen">
    <aside class="w-64 bg-gradient-to-b from-slate-900 to-slate-800 text-white flex flex-col fixed h-full z-10">
        <div class="p-6 border-b border-slate-700/50">
            <div class="flex items-center space-x-3">
                <div class="w-10 h-10 bg-gradient-to-br from-indigo-500 to-purple-600 rounded-xl flex items-center justify-center">
                    <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                    </svg>
                </div>
                <div>
                    <h1 class="text-lg font-bold tracking-tight">TechFlow</h1>
                    <p class="text-xs text-slate-400">Backoffice</p>
                </div>
            </div>
        </div>

        <nav class="flex-1 py-6 px-3 space-y-1">
            <a href="{{ path('app_dashboard') }}" class="flex items-center px-4 py-3 rounded-xl text-sm font-medium transition-all duration-200 {% if app.request.attributes.get('_route') == 'app_dashboard' %}bg-indigo-600/20 text-indigo-300 border border-indigo-500/30{% else %}text-slate-300 hover:bg-slate-700/50 hover:text-white{% endif %}">
                <svg class="w-5 h-5 mr-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                </svg>
                Tableau de bord
            </a>

            {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_user_index') }}" class="flex items-center px-4 py-3 rounded-xl text-sm font-medium transition-all duration-200 {% if 'app_user' in app.request.attributes.get('_route') %}bg-indigo-600/20 text-indigo-300 border border-indigo-500/30{% else %}text-slate-300 hover:bg-slate-700/50 hover:text-white{% endif %}">
                <svg class="w-5 h-5 mr-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
                </svg>
                Utilisateurs
            </a>
            {% endif %}

            <a href="{{ path('app_product_index') }}" class="flex items-center px-4 py-3 rounded-xl text-sm font-medium transition-all duration-200 {% if 'app_product' in app.request.attributes.get('_route') %}bg-indigo-600/20 text-indigo-300 border border-indigo-500/30{% else %}text-slate-300 hover:bg-slate-700/50 hover:text-white{% endif %}">
                <svg class="w-5 h-5 mr-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
                </svg>
                Produits
            </a>

            {% if is_granted('ROLE_MANAGER') or is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_client_index') }}" class="flex items-center px-4 py-3 rounded-xl text-sm font-medium transition-all duration-200 {% if 'app_client' in app.request.attributes.get('_route') %}bg-indigo-600/20 text-indigo-300 border border-indigo-500/30{% else %}text-slate-300 hover:bg-slate-700/50 hover:text-white{% endif %}">
                <svg class="w-5 h-5 mr-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                </svg>
                Clients
            </a>
            {% endif %}
        </nav>

        <div class="p-4 border-t border-slate-700/50">
            <div class="flex items-center space-x-3 px-3 py-2">
                <div class="w-9 h-9 bg-gradient-to-br from-emerald-400 to-teal-500 rounded-full flex items-center justify-center text-sm font-bold text-white">
                    {{ app.user.firstname|first }}{{ app.user.lastname|first }}
                </div>
                <div class="flex-1 min-w-0">
                    <p class="text-sm font-medium text-white truncate">{{ app.user.fullName }}</p>
                    <p class="text-xs text-slate-400 truncate">{{ app.user.email }}</p>
                </div>
            </div>
            <a href="{{ path('app_logout') }}" class="mt-3 flex items-center px-4 py-2 rounded-xl text-sm text-red-400 hover:bg-red-500/10 hover:text-red-300 transition-all duration-200">
                <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                </svg>
                Déconnexion
            </a>
        </div>
    </aside>

    <main class="flex-1 ml-64">
        <header class="bg-white/80 backdrop-blur-lg border-b border-gray-200/50 sticky top-0 z-5 px-8 py-4">
            <div class="flex items-center justify-between">
                <h2 class="text-xl font-semibold text-gray-800">{% block page_title %}Tableau de bord{% endblock %}</h2>
                <div class="flex items-center space-x-4">
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium
                        {% if is_granted('ROLE_ADMIN') %}
                            bg-red-100 text-red-700
                        {% elseif is_granted('ROLE_MANAGER') %}
                            bg-amber-100 text-amber-700
                        {% else %}
                            bg-blue-100 text-blue-700
                        {% endif %}
                    ">
                        {% if is_granted('ROLE_ADMIN') %}Admin
                        {% elseif is_granted('ROLE_MANAGER') %}Manager
                        {% else %}Utilisateur
                        {% endif %}
                    </span>
                </div>
            </div>
        </header>

        <div class="p-8">
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="mb-4 p-4 rounded-xl border
                        {% if type == 'success' %}bg-emerald-50 border-emerald-200 text-emerald-700
                        {% elseif type == 'error' %}bg-red-50 border-red-200 text-red-700
                        {% else %}bg-blue-50 border-blue-200 text-blue-700{% endif %}
                    ">
                        <div class="flex items-center">
                            {% if type == 'success' %}
                                <svg class="w-5 h-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                            {% endif %}
                            {{ message }}
                        </div>
                    </div>
                {% endfor %}
            {% endfor %}

            {% block content %}{% endblock %}
        </div>
    </main>
</div>
{% endblock %}
