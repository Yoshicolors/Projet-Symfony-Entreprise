{% extends 'layout.html.twig' %}

{% block page_title %}Produits{% endblock %}

{% block content %}
<div class="flex items-center justify-between mb-6">
    <p class="text-sm text-gray-500">{{ products|length }} produit(s) — triés par prix décroissant</p>
    <div class="flex items-center space-x-3">
        <a href="{{ path('app_product_export') }}" class="inline-flex items-center px-4 py-2 bg-white border border-gray-200 text-gray-700 text-sm font-medium rounded-xl shadow-sm hover:bg-gray-50 transition-all duration-200">
            <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            Exporter CSV
        </a>
        {% if is_granted('ROLE_ADMIN') %}
        <a href="{{ path('app_product_new') }}" class="inline-flex items-center px-4 py-2 bg-gradient-to-r from-indigo-600 to-purple-600 text-white text-sm font-medium rounded-xl shadow-sm hover:shadow-md transition-all duration-200">
            <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
            Ajouter un produit
        </a>
        {% endif %}
    </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {% for product in products %}
    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-md transition-all duration-300 overflow-hidden group">
        <div class="p-6">
            <div class="flex items-start justify-between mb-4">
                <div class="w-10 h-10 rounded-xl flex items-center justify-center
                    {% if product.productType == 'physical' %}bg-blue-100 text-blue-600{% else %}bg-purple-100 text-purple-600{% endif %}">
                    {% if product.productType == 'physical' %}
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
                    {% else %}
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                    {% endif %}
                </div>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium
                    {% if product.productType == 'physical' %}bg-blue-50 text-blue-700{% else %}bg-purple-50 text-purple-700{% endif %}">
                    {{ product.productType == 'physical' ? 'Physique' : 'Numérique' }}
                </span>
            </div>

            <h3 class="text-lg font-semibold text-gray-900 mb-1">{{ product.name }}</h3>
            <p class="text-sm text-gray-500 mb-4 line-clamp-2">{{ product.description|default('Aucune description') }}</p>

            <div class="flex items-center justify-between">
                <span class="text-xl font-bold text-gray-900">{{ product.price|number_format(2, ',', ' ') }} €</span>
                {% if product.productType == 'physical' and product.stock is not null %}
                    <span class="text-xs text-gray-400">Stock: {{ product.stock }}</span>
                {% endif %}
            </div>
        </div>

        {% if is_granted('ROLE_ADMIN') %}
        <div class="px-6 py-3 bg-gray-50/50 border-t border-gray-100 flex items-center justify-end space-x-2 opacity-0 group-hover:opacity-100 transition-opacity duration-200">
            <a href="{{ path('app_product_edit', {id: product.id}) }}" class="p-2 text-gray-400 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg transition-all duration-200">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
            </a>
            <form action="{{ path('app_product_delete', {id: product.id}) }}" method="POST" class="inline" onsubmit="return confirm('Supprimer ce produit ?')">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ product.id) }}">
                <button type="submit" class="p-2 text-gray-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition-all duration-200">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                </button>
            </form>
        </div>
        {% endif %}
    </div>
    {% else %}
    <div class="col-span-full text-center py-12">
        <div class="w-16 h-16 bg-gray-100 rounded-2xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
        </div>
        <p class="text-sm text-gray-500">Aucun produit enregistré</p>
    </div>
    {% endfor %}
</div>
{% endblock %}
